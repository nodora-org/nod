signal Deny(reason)
signal Ask(reason)

rule ForcePush {
    is_bash = input.tool == "bash"
    cmd     = input.cmd

    git_push = strings::contains(cmd, "git push")
    force    = strings::contains(cmd, "-f")

    emit Ask("force push rewrites history") when is_bash && git_push && force
}

rule CurlPipe {
    is_bash = input.tool == "bash"
    cmd     = input.cmd

    pipe_to_sh  = strings::contains(cmd, "| sh") || strings::contains(cmd, "| bash")
    curl_pipe   = strings::contains(cmd, "curl") && pipe_to_sh

    emit Deny("remote code execution: download piped to a shell") when is_bash && curl_pipe
}